{
  "rules": {
    ".read": false,
    ".write": false,

    "staff": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },

    "admin": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('staff').child(auth.uid).val() === true"
    },

    "sessions": {
      "$gameId": {
        ".read": "auth != null && $gameId.matches(/^[0-9]{4}$/)",
        ".write": "auth != null && $gameId.matches(/^[0-9]{4}$/) && root.child('staff').child(auth.uid).val() === true",

        "status": { ".validate": "newData.isString() && newData.val().length <= 24" },
        "mode": { ".validate": "newData.val() == null || newData.val() == 'solo' || newData.val() == 'multiplayer'" },
        "winner": { ".validate": "newData.val() == null || newData.val() == 'players' || newData.val() == 'monster'" },
        "log": { "$i": { ".validate": "newData.isString() && newData.val().length <= 200" } },

        "lastActionAt": {
          ".write": "auth != null && data.parent().exists()",
          ".validate": "newData.isNumber()"
        },

        "lobby": {
          "$playerId": {
            ".write": "auth != null && data.parent().parent().exists() && (data.exists() ? data.child('uid').val() === auth.uid : newData.child('uid').val() === auth.uid) && (!newData.exists() || newData.child('uid').val() === auth.uid)",
            ".validate": "newData.hasChildren(['id', 'uid', 'slot']) && newData.child('id').val() === $playerId && newData.child('slot').isNumber() && newData.child('slot').val() >= 0 && newData.child('slot').val() <= 3",
            "id": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "uid": { ".validate": "newData.isString()" },
            "slot": { ".validate": "newData.isNumber()" },
            "label": { ".validate": "newData.isString() && newData.val().length <= 24" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "soloRequested": { ".validate": "newData.isBoolean()" },
            "characterId": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "confirmed": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        },

        "presence": {
          "$playerId": {
            ".write": "auth != null && (root.child('sessions').child($gameId).child('lobby').child($playerId).child('uid').val() === auth.uid || (!newData.exists() && !root.child('sessions').child($gameId).child('lobby').child($playerId).exists()))",
            ".validate": "newData.isBoolean()"
          }
        },

        "pendingMoves": {
          "$playerId": {
            ".write": "auth != null && !data.exists() && newData.exists() && root.child('sessions').child($gameId).child('status').val() === 'battle' && root.child('sessions').child($gameId).child('players').child($playerId).exists() && root.child('sessions').child($gameId).child('lobby').child($playerId).child('uid').val() === auth.uid",
            ".validate": "newData.hasChildren(['moveId', 'playerId', 'token']) && newData.child('playerId').val() === $playerId",
            "moveId": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "playerId": { ".validate": "newData.isString()" },
            "token": { ".validate": "newData.isString() && newData.val().length <= 120" },
            "createdAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },

        "tutorialAcks": {
          "$playerId": {
            ".write": "auth != null && root.child('sessions').child($gameId).child('lobby').child($playerId).child('uid').val() === auth.uid",
            ".validate": "newData.isBoolean()"
          }
        },

        "$other": { ".validate": true }
      }
    }
  }
}